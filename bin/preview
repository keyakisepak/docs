#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if ! command -v ruby >/dev/null || ! command -v bundle >/dev/null; then
  printf '%s\n' 'Ruby と Bundler が必要です。Ubuntu / WSL では次を実行してください。' >&2
  printf '%s\n' 'sudo apt-get install ruby ruby-dev ruby-bundler build-essential' >&2
  exit 1
fi

export BUNDLE_PATH="${BUNDLE_PATH:-vendor/bundle}"
bundle check || bundle install

printf '%s\n' 'Preview: http://localhost:4000/docs/'
exec bundle exec jekyll serve --host 127.0.0.1 --port 4000 --livereload "$@"
